include_guard(GLOBAL)

set(CPACK_PACKAGE_NAME "${CMAKE_PROJECT_NAME}")
set(CPACK_PACKAGE_VERSION "${PLUGIN_VERSION}")
set(CPACK_PACKAGE_VENDOR "${PLUGIN_AUTHOR}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Independent read-only canvas previews for OBS Studio")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE")
set(CPACK_OUTPUT_FILE_PREFIX "${CMAKE_CURRENT_SOURCE_DIR}/release")
set(CPACK_VERBATIM_VARIABLES YES)

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$" OR CMAKE_VS_PLATFORM_NAME STREQUAL "ARM64")
  set(OP_PACKAGE_ARCH arm64)
  set(OP_DEB_ARCH arm64)
else()
  set(OP_PACKAGE_ARCH x64)
  set(OP_DEB_ARCH amd64)
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(CPACK_GENERATOR DEB)
  set(CPACK_PACKAGE_FILE_NAME "${CMAKE_PROJECT_NAME}_${PLUGIN_VERSION}_linux-${OP_DEB_ARCH}")
  set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${OP_DEB_ARCH}")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${PLUGIN_AUTHOR}")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SECTION video)
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "obs-studio (>= 31.1.0)")
  set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.deb")
  set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
  include(CPack)
endif()
